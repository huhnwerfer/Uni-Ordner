        "id": "f7635e3c"
      },
      "source": [
        "\n",
        "## 8. Grouping and Extracting\n",
        "\n",
        "Parentheses create **groups** that can be extracted.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 86,
      "id": "7f34ce3b",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "7f34ce3b",
        "outputId": "b3b356b9-6a39-41e0-f5c6-5220bd643e54"
      },
      "outputs": [
        {
          "data": {
            "text/plain": [
              "(('123', '456'), '456')"
            ]
          },
          "execution_count": 86,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "text = \"My number is 123-456\"\n",
        "match = re.search(r\"(\\d+)-(\\d+)\", text)\n",
        "match.groups(), match.groups()[1]"
      ]
    },
